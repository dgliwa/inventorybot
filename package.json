{
  "name": "openclaw-plugin-inventorybot",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build",
    "plugin:validate": "npm run build && node ./scripts/validate-plugin.mjs",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "scripts/validate-plugin.mjs"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.8"
  },
  "dependencies": {
    "typebox": "^1.1.38",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "openclaw": "latest",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.8"
    },
    "build": {
      "openclawVersion": "2026.9.8"
    }
  }
}
